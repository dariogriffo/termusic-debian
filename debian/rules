#!/usr/bin/make -f
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
PKG_VERSION := $(shell dpkg-parsechangelog -S Version | sed 's/[-~].*//')

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	@arch="$(DEB_HOST_ARCH)"; \
	case "$$arch" in \
		amd64) TERMUSIC_RELEASE="termusic-v$(PKG_VERSION)-x86_64-linux" ;; \
		arm64) TERMUSIC_RELEASE="termusic-v$(PKG_VERSION)-aarch64-linux" ;; \
		*) echo "Unsupported architecture: $$arch"; exit 1 ;; \
	esac; \
	echo "Downloading $$TERMUSIC_RELEASE for $(PKG_VERSION)..."; \
	wget -q "https://github.com/tramhao/termusic/releases/download/v$(PKG_VERSION)/$$TERMUSIC_RELEASE.tar.xz"; \
	tar -xf "$$TERMUSIC_RELEASE.tar.xz"; \
	rm -f "$$TERMUSIC_RELEASE.tar.xz"; \
	echo "$$TERMUSIC_RELEASE" > .termusic_release_name

override_dh_auto_install:
	@TERMUSIC_RELEASE=$$(cat .termusic_release_name); \
	install -D -m 755 "$$TERMUSIC_RELEASE/termusic"        debian/termusic/usr/bin/termusic; \
	install -D -m 755 "$$TERMUSIC_RELEASE/termusic-server" debian/termusic/usr/bin/termusic-server

override_dh_auto_test:

override_dh_auto_clean:
	@if [ -f .termusic_release_name ]; then \
		TERMUSIC_RELEASE=$$(cat .termusic_release_name); \
		rm -rf "$$TERMUSIC_RELEASE" .termusic_release_name || true; \
	fi

override_dh_strip:

override_dh_shlibdeps:
